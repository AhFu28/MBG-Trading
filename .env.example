# Supabase Credentials (Optional for local fallback, required for live cloud sync)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# Google Gemini API Key (Optional for deterministic mode, recommended for deep synthesis)
GEMINI_API_KEY=your-gemini-api-key

# Telegram Bot Notifications (Optional - will send alerts if set)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-botfather
TELEGRAM_CHAT_ID=your-telegram-chat-id-or-channel-id

# IndexAlpha API Key for real broker summary data
INDEX_ALPHA_API_KEY=your_indexalpha_api_key_here
