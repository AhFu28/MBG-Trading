# Supabase Credentials (Optional for local fallback, required for live cloud sync)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# Google Gemini API Key (Optional for deterministic mode, recommended for deep synthesis)
GEMINI_API_KEY=your-gemini-api-key

# Telegram Bot Notifications (Optional - will send alerts if set)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-botfather
TELEGRAM_CHAT_ID=your-telegram-chat-id-or-channel-id

# IndexAlpha API Key for real broker summary data
INDEX_ALPHA_API_KEY=your_indexalpha_api_key_here

# ── Cockpit access gate (Cloudflare Pages Function: /api/auth) ───────────────
# REQUIRED for web login. If either value is missing or invalid, /api/auth fails
# closed with HTTP 503 and EVERY visitor is locked out — including the owner.
# Set these as encrypted environment variables in the hosting dashboard; never
# commit real values. (Identified as release blocker B5 by independent review.)
#
# PASSWORD_HASH: lowercase hex SHA-256 of the shared access password.
#   generate:  printf '%s' 'your-password' | sha256sum
PASSWORD_HASH=replace-with-lowercase-hex-sha256-of-the-access-password
#
# JWT_SECRET: random string, minimum 16 chars (use 32+). Signs the HttpOnly
# session cookie. Rotating it invalidates all existing sessions.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# DANGEROUS — must NOT be "true" in production. If it is true AND JWT_SECRET is
# missing or shorter than 16 chars, sessions are signed with a PUBLIC constant
# ('insecure-dev-only-secret') and anyone who reads the source can forge a
# valid session cookie. Leave unset or false.
MBG_ALLOW_INSECURE_DEV_SECRET=false

# Local development only. In a production build this branch is dead code because
# Vite statically replaces import.meta.env.DEV with false.
VITE_MBG_DEV_AUTH_BYPASS=false

# Optional VIP channel allowlist (comma-separated Telegram chat ids) — an
# alternative to engine/config/vip_subscribers.json for scripts/send_vip_signals.py
MBG_VIP_CHAT_IDS=
