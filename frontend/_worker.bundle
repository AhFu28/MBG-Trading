async function onRequestPost(context) {
  const { request, env } = context;
  const botToken = env.TELEGRAM_BOT_TOKEN;
  if (!botToken) {
    return new Response("TELEGRAM_BOT_TOKEN not configured in Cloudflare Environment", { status: 500 });
  }
  try {
    const update = await request.json();
    const message = update.message || update.channel_post;
    if (!message || !message.text) {
      return new Response("OK", { status: 200 });
    }
    const chatId = message.chat?.id;
    const messageId = message.message_id;
    const text = message.text;
    const { type, arg } = parseCommand(text);
    if (type === "UNKNOWN") {
      return new Response("OK", { status: 200 });
    }
    let bundle = {};
    try {
      const url = new URL(request.url);
      const bundleUrl = `${url.origin}/data/latest_cockpit_bundle.json`;
      const res = await fetch(bundleUrl);
      if (res.ok) {
        bundle = await res.json();
      }
    } catch (e) {
      console.warn("Could not fetch bundle:", e);
    }
    let reply = "";
    if (type === "HELP") {
      reply = "\u{1F916} <b>PANDUAN PERINTAH BOT MBG TRADING (24/7 CLOUD)</b>\n\nKetik salah satu perintah berikut di grup kapan saja:\n\u2022 <code>/saham &lt;KODE&gt;</code> \u2794 Cek analisa & level harga saham BEI (cth: <code>/saham BBCA</code>)\n\u2022 <code>/crypto &lt;KOIN&gt;</code> \u2794 Cek harga spot & level kripto (cth: <code>/crypto BTC</code>)\n\u2022 <code>/news</code> (atau <code>/snips</code>) \u2794 Rekap harian pasar & berita berpoin\n\u2022 <code>/plan</code> \u2794 Daftar rekomendasi saham & kripto hari ini\n\n\u{1F4A1} <i>Tips: Anda juga bisa ketik santai tanpa garis miring, contoh: <code>cek BBCA</code> atau <code>snips</code>.</i>";
    } else if (type === "NEWS") {
      const macro = bundle.macro_telemetry || {};
      const snips = macro.daily_snips || {};
      const verdict = snips.market_verdict || {};
      const goldP = macro.gold_price || 2750;
      const goldC = macro.gold_change_pct || 0;
      const oilP = macro.brent_oil_price || 74;
      const oilC = macro.brent_oil_change_pct || 0;
      const dxy = macro.dxy_index || 104.5;
      const stanceBadge = verdict.badge || (goldC > 0 ? "\u{1F7E2} ROTASI KOMODITAS" : "\u26AA KONSOLIDASI PASAR");
      const narrative = verdict.narrative || macro.full_narrative || "IHSG bergerak konsolidatif dengan selektivitas saham solid.";
      const newsList = (macro.live_news || []).slice(0, 3);
      let newsFormatted = "";
      newsList.forEach((n, idx) => {
        const takeaways = n.key_takeaways && n.key_takeaways.length ? n.key_takeaways.slice(0, 2).map((t) => `   \u25AB\uFE0F ${t}`).join("\n") : `   \u25AB\uFE0F ${n.summary || "Berita pasar dan sentimen terkini."}`;
        newsFormatted += `${idx + 1}. <b>${n.title}</b> (<i>${n.source}</i>)
${takeaways}

`;
      });
      reply = `\u{1F4F0} <b>MBG DAILY MARKET SNIPS & MACRO BRIEF</b>
Status: ${stanceBadge}

\u{1F30D} <b>Indikator Komoditas & Dolar:</b>
  \u2022 Emas Dunia  : $${goldP.toLocaleString()} (${goldC > 0 ? "+" : ""}${goldC}%) ${goldC > 0 ? "\u{1F7E2}" : "\u{1F534}"}
  \u2022 Minyak Brent: $${oilP.toLocaleString()} (${oilC > 0 ? "+" : ""}${oilC}%) ${oilC > 0 ? "\u{1F7E2}" : "\u{1F534}"}
  \u2022 DXY Dollar  : ${dxy} pts \u{1F7E1}

\u{1F3AF} <b>Market Verdict:</b>
<i>${narrative}</i>

\u{1F525} <b>Berita Pilihan & Poin Kunci:</b>
${newsFormatted || "1. Pasar finansial konsolidasi sehat.\n\n"}\u{1F4A1} <b>Saran Trader:</b>
<i>${snips.actionable_guidance || "Disiplin pasang stop loss 3-4% dan hindari FOMO."}</i>`;
    } else if (type === "PLAN") {
      const plans = bundle.daily_trade_plans || [];
      if (!plans.length) {
        reply = "\u{1F3AF} <b>SAHAM PILIHAN HARI INI</b>\n\n<i>Belum ada trade plan terbit hari ini. Silakan cek kembali saat pasar buka.</i>";
      } else {
        const idxPlans = plans.filter((p) => p.market === "IDX").slice(0, 3);
        const cryptoPlans = plans.filter((p) => p.market === "CRYPTO").slice(0, 2);
        let lines = ["\u{1F3AF} <b>SAHAM & KRIPTO PILIHAN HARI INI</b>\n"];
        idxPlans.forEach((p) => {
          lines.push(`\u{1F7E2} <b>$${p.clean_ticker || p.symbol}</b> [Buy Area: Rp ${p.entry_price?.toLocaleString()}]
   \u{1F534} SL: Rp ${p.stop_loss?.toLocaleString()} | \u{1F7E2} TP: Rp ${p.target_1?.toLocaleString()}`);
        });
        cryptoPlans.forEach((c) => {
          lines.push(`\u{1FA99} <b>${c.symbol}</b> [Buy: $${c.entry_price}]
   \u{1F534} SL: $${c.stop_loss} | \u{1F7E2} TP: $${c.target_1}`);
        });
        lines.push("\n\u26A0\uFE0F <i>Pasang batas rugi (Stop Loss) otomatis di sekuritas Anda!</i>");
        reply = lines.join("\n");
      }
    } else if (type === "SAHAM_EMPTY") {
      reply = "\u26A0\uFE0F <b>KODE SAHAM BELUM DIISI</b>\n\nFormat: <code>/saham &lt;KODE&gt;</code>\nContoh: <code>/saham BBCA</code> atau <code>/saham ANTM</code>";
    } else if (type === "CRYPTO_EMPTY") {
      reply = "\u26A0\uFE0F <b>KODE KRIPTO BELUM DIISI</b>\n\nFormat: <code>/crypto &lt;KOIN&gt;</code>\nContoh: <code>/crypto BTC</code> atau <code>/crypto SOL</code>";
    } else if (type === "SAHAM") {
      const plans = bundle.daily_trade_plans || [];
      const match2 = plans.find((p) => (p.clean_ticker || p.symbol || "").toUpperCase() === arg);
      if (match2) {
        reply = `\u{1F4C8} <b>ANALISA SAHAM: $${arg}</b>
Status: \u{1F7E2} <b>AKUMULASI (SINYAL RESMI)</b>

\u{1F4B5} Harga Acuan     : Rp ${match2.entry_price?.toLocaleString()}
\u{1F4CA} Sinyal Teknikal : <b>${match2.technical_signal || "BUY"}</b>

\u{1F3AF} <b>PANDUAN TRADING:</b>
  \u{1F7E2} Buy Area       : Rp ${match2.entry_price?.toLocaleString()}
  \u{1F534} Stop Loss (SL) : Rp ${match2.stop_loss?.toLocaleString()} (Disiplin Cut Loss jika jebol!)
  \u{1F7E2} Target Untung  : Rp ${match2.target_1?.toLocaleString()} (R:R 1:${match2.risk_reward_ratio || 2})

\u{1F4A1} <i>Catatan: ${match2.opinion_thesis || "Didukung akumulasi terukur."}</i>`;
      } else {
        reply = `\u{1F4C8} <b>ANALISA SAHAM: $${arg}</b>
Status: \u{1F7E2} <b>WATCHLIST BURSA EFEK INDONESIA</b>

\u{1F4CA} Informasi saham <b>$${arg}</b> siap dipantau.
\u{1F4A1} <i>Saran: Gunakan manajemen risiko ketat dan pantau volume saat pembukaan sesi 1.</i>`;
      }
    } else if (type === "CRYPTO") {
      const cryptos = bundle.crypto_spot_10 || [];
      const pairKey = `${arg}/USDT`;
      const match2 = cryptos.find((c) => c.pair === pairKey || c.pair === arg);
      if (match2) {
        reply = `\u{1FA99} <b>ANALISA KRIPTO: ${pairKey}</b>
Status: \u{1F7E2} <b>TREN POSITIF (SPOT WATCHLIST)</b>

\u{1F4B5} Harga Spot     : $${match2.current_price}
\u{1F4CA} Signal Teknikal: <b>${match2.technical_signal || "LONG"}</b>

\u{1F3AF} <b>LEVEL KRUSIAL:</b>
  \u{1F7E2} Buy Area           : $${match2.current_price}
  \u{1F534} Stop Loss (SL)     : $${match2.stop_loss}
  \u{1F7E2} Target Profit (TP) : $${match2.take_profit_1}

\u{1F4A1} <i>Saran Awam: Kripto aktif 24 jam. Pasang limit order demi keamanan dana.</i>`;
      } else {
        reply = `\u{1FA99} <b>ANALISA KRIPTO: ${arg}/USDT</b>
Status: \u{1F7E2} <b>SPOT MARKET WATCH</b>

Koin <b>${arg}</b> dipantau pada pasar spot USDT.
\u{1F4A1} <i>Saran: Selalu gunakan batas risiko stop loss terukur.</i>`;
      }
    }
    if (reply) {
      await sendTelegramReply(botToken, chatId, messageId, reply);
    }
    return new Response("OK", { status: 200 });
  } catch (err) {
    console.error("Webhook processing error:", err);
    return new Response("Internal Server Error", { status: 500 });
  }
}
