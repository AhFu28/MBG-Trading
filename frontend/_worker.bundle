var POPULAR_ALIASES = {
  BCA: "BBCA",
  BRI: "BBRI",
  MANDIRI: "BMRI",
  BNI: "BBNI",
  TELKOM: "TLKM",
  ASTRA: "ASII",
  ANTAM: "ANTM",
  MEDCO: "MEDC",
  ADARO: "ADRO",
  UNILEVER: "UNVR",
  INDOFOOD: "INDF",
  VALE: "INCO",
  BUKAPALAK: "BUKA",
  GOTO: "GOTO",
  BITCOIN: "BTC",
  ETHEREUM: "ETH",
  SOLANA: "SOL",
  RIPPLE: "XRP",
